PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/colab
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Optional. Without these, verification codes are printed in the server log
# and returned by the signup API, and uploads are stored under backend-main/images.
MAILTRAP_TOKEN=
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Instagram scraping headers used by utils/scrapeInstagram.js
USER_AGENT=
X_IG_APP_ID=
